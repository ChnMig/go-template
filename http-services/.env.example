# 环境变量配置示例
# 本项目不会自动加载 .env；请通过 shell、direnv 或部署系统注入环境变量。
# 本地示例：cp .env.example .env && set -a && source .env && set +a
#
# 注意：环境变量会覆盖 config.yaml 中的对应配置

# 服务器配置
HTTP_SERVICES_SERVER_PORT=8080
# HTTP_SERVICES_SERVER_MAX_BODY_SIZE="10MB"
# HTTP_SERVICES_SERVER_ENABLE_RATE_LIMIT=true
# HTTP_SERVICES_SERVER_GLOBAL_RATE_LIMIT=100
# HTTP_SERVICES_SERVER_GLOBAL_RATE_BURST=200

# JWT 配置
HTTP_SERVICES_JWT_KEY="YOUR_SECRET_KEY_HERE_AT_LEAST_32_CHARACTERS"
HTTP_SERVICES_JWT_EXPIRATION="12h"

# 日志配置
# HTTP_SERVICES_LOG_MAX_SIZE=50
# HTTP_SERVICES_LOG_MAX_AGE=30
# HTTP_SERVICES_LOG_LEVEL="info"
# HTTP_SERVICES_LOG_GIN_LEVEL=""

# 数据库配置
# HTTP_SERVICES_DATABASE_MYSQL_DSN="user:pass@tcp(127.0.0.1:3306)/app?charset=utf8mb4&parseTime=True&loc=Local"

# Redis 配置
# HTTP_SERVICES_REDIS_HOST="127.0.0.1:6379"
# HTTP_SERVICES_REDIS_PASSWORD=""

# 运行模式
# model=dev      # 开发模式
# model=release  # 生产模式
